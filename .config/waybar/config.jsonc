{
    "reload_style_on_change": true,

    "layer": "top",
    "position": "top",
	"mod": "dock",
	"exclusive": true,
	"passthrough": false,
	"gtk-layer-shell": true,

    "modules-left": [
	"hyprland/workspaces"
    ],
    "modules-center": [
    ],
    "modules-right": [
	"custom/wireguard",
	"pulseaudio",
	"battery",
	"network",
	"tray",
	"clock",
	"custom/sep",
      	"cpu",
        "custom/sep",
        "memory",
	//"custom/sep",
	//"gpu",
        "custom/sep",
        "disk"
    ],

    "hyprland/workspaces": {
	"format": "{icon}",
	"on-click": "activate",
	"format-icons": {
	    "1": "一",
	    "2": "二",
	    "3": "三",
	    "4": "四",
	    "5": "五",
	    "6": "六",
	    "7": "七",
	    "8": "八",
	    "9": "九",
	    "10": "十"
	},
	"sort-by-number": true
    },

    "custom/wireguard": {
        "exec": "systemctl is-active --quiet wg-quick-work && echo '{ \"text\": \"wg-work: UP\", \"class\": \"wireguard\" }'",
        "return-type": "json",
	"interval": 5,
        "format": "{text}",
        "hide-empty-text": true
    },

    "battery": {
   	"interval": 10,
  	"states": {
            "warning": 30,
            "critical": 15
   	},
   	"format": "{icon} {capacity}%",
   	"format-charging": "󰂄 {capacity}%",
    	"format-plugged": "󰚥 {capacity}%",
    	"format-full": "󰁹 {capacity}%",
    	"format-icons": [
           "󰂎",
           "󰁺",
           "󰁻",
           "󰁼",
           "󰁽",
           "󰁾",
           "󰁿",
           "󰂀",
           "󰂁",
           "󰂂",
           "󰁹"
    	]
    },

    "clock": {
	"format": "{:%H:%M}",
  	"format-alt": "{:%Y-%m-%d}",
	"tooltip-format": "{:%a %d-%m-%Y %b}"
    },

    "pulseaudio": {
        "scroll-step": 0,
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁 {volume}%",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾", "󰓃"]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
	"format-wifi-alt": "{ipaddr}",
        "format-ethernet": "󰈀 ",
	"format-ethernet-alt": "{ipaddr}",
        "format-disconnected": "󰖪",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "tooltip-format-wifi": "󰖩 {essid}\nSignal: {signalStrength}%\n󰒋 {gwaddr} at {ifname}",
        "tooltip-format-ethernet": "󰈀 {ipaddr}\n󰒋 {gwaddr} at {ifname}",
        "tooltip-format-disconnected": "󰖪 No connection"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "tooltip": false
    },
    
    "memory": {
        "format": "󰢮 {percentage}%",
	"format-alt": "󰢮 {used}GiB"
    }, 
    
    "disk": {
        "interval": 60,
        "path": "/",
        "format": "󰆓 {percentage_used}%",
        "format-alt": "󰆓 {free}"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
